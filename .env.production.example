# ============================================================================
# ShopZone Production Environment Template (.env.production.example)
# Hardened configuration for AWS Production (ECS / EKS / App Runner / EC2)
# ============================================================================

# 1. Environment & Project Metadata
ENVIRONMENT=production
PROJECT_NAME="ShopZone Enterprise"
VERSION="2.0.0"
DEBUG=false

# 2. Production Database (AWS Aurora PostgreSQL / RDS)
# Replace with your AWS RDS Endpoint retrieved from AWS Secrets Manager
DATABASE_URL=postgresql://db_master_user:${RDS_DB_PASSWORD}@shopzone-aurora-cluster.cluster-xyz.ap-south-1.rds.amazonaws.com:5432/shopzone_prod?sslmode=require
POSTGRES_DB=shopzone_prod

# 3. Redis / AWS ElastiCache
# Replace with your AWS ElastiCache Redis replication group endpoint with TLS enabled
CELERY_BROKER_URL=rediss://default:${REDIS_AUTH_TOKEN}@shopzone-cache.xyz.ap-south-1.cache.amazonaws.com:6379/0
CELERY_RESULT_BACKEND=rediss://default:${REDIS_AUTH_TOKEN}@shopzone-cache.xyz.ap-south-1.cache.amazonaws.com:6379/1
REDIS_URL=rediss://default:${REDIS_AUTH_TOKEN}@shopzone-cache.xyz.ap-south-1.cache.amazonaws.com:6379/0

# 4. Security & Cryptographic Keys
# Generate via: openssl rand -hex 64
SECRET_KEY=CHANGE_THIS_TO_A_64_BYTE_HEX_GENERATED_SECRET_STORED_IN_AWS_SECRETS_MANAGER
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 5. Production AI Configuration & Fallback Keys
AI_EMBEDDING_PROVIDER=local_hash
AI_DEFAULT_LLM_PROVIDER=groq
AI_FALLBACK_PROVIDERS=groq,mistral,gemini
GROQ_API_KEY=${AWS_SECRETS_GROQ_API_KEY}
MISTRAL_API_KEY=${AWS_SECRETS_MISTRAL_API_KEY}
GEMINI_API_KEY=${AWS_SECRETS_GEMINI_API_KEY}

# 6. RAG Vector Database
CHROMA_PERSIST_DIRECTORY=/app/data/chroma_db
AI_CACHE_TTL_SECONDS=86400
AI_RATE_LIMIT="60/minute"
RAG_TOP_K=4
RAG_DISTANCE_THRESHOLD=1.65

# 7. Production CORS & Security Headers
CORS_ORIGINS=["https://shopzone.example.com","https://www.shopzone.example.com"]
GZIP_MINIMUM_SIZE=500
