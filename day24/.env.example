# ==============================================================================
# ShopZone Day 24 - Production Environment Variables Template
# Copy this file to .env on your AWS EC2 instance:
#   cp day24/.env.example .env
# Replace all placeholder values before launching Docker Compose.
# NEVER commit the real .env or secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General & DevOps Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
PROJECT_NAME="ShopZone E-Commerce API"
VERSION=1.0.0

# ------------------------------------------------------------------------------
# 2. Domain & CORS Configuration
# Include your Vercel frontend domain, EC2 Elastic IP, and custom domain:
# ------------------------------------------------------------------------------
FRONTEND_ORIGINS=https://shopzone-frontend.vercel.app,https://yourdomain.com,http://localhost:5173

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database (Docker Service or Amazon RDS)
# ------------------------------------------------------------------------------
DATABASE_ENGINE=postgres
POSTGRES_USER=shopzone_admin
POSTGRES_PASSWORD=generate_a_strong_random_database_password_here
POSTGRES_DB=shopzone_production
PGHOST=postgres
PGPORT=5432
PGDATABASE=shopzone_production
PGUSER=shopzone_admin
PGPASSWORD=generate_a_strong_random_database_password_here

# ------------------------------------------------------------------------------
# 4. Redis Cache & Celery Message Broker
# ------------------------------------------------------------------------------
REDIS_PASSWORD=generate_a_strong_random_redis_password_here
CELERY_BROKER_URL=redis://:generate_a_strong_random_redis_password_here@redis:6379/0
CELERY_RESULT_BACKEND=redis://:generate_a_strong_random_redis_password_here@redis:6379/1
REDIS_URL=redis://:generate_a_strong_random_redis_password_here@redis:6379/0

# ------------------------------------------------------------------------------
# 5. JWT Authentication Security
# Generate 32+ cryptographically random bytes (e.g. openssl rand -hex 32)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=generate_at_least_32_bytes_cryptographically_secure_random_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 6. Observability: Sentry & Prometheus
# Optional: Leave SENTRY_DSN blank if not using Sentry
# ------------------------------------------------------------------------------
SENTRY_DSN=
PROMETHEUS_METRICS_ENABLED=true

# ------------------------------------------------------------------------------
# 7. AI Assistant & LLM API Keys (Groq / Gemini / Mistral / OpenAI)
# ------------------------------------------------------------------------------
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=groq,mistral,openai_compatible
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 8. Rate Limiting Settings
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT=100/minute
LOGIN_RATE_LIMIT=5/minute
ORDER_RATE_LIMIT=20/minute
AI_RATE_LIMIT=20/minute

# ------------------------------------------------------------------------------
# 9. Persistent Storage Paths
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIR=chroma_db
EMBEDDING_PROVIDER=local_hash
