# Database Configuration
DATABASE_ENGINE=postgres
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=sqlight
PGUSER=Thriveni
PGPASSWORD=your_postgres_password_here

# JWT Authentication
JWT_SECRET_KEY=at_least_32_bytes_super_secret_jwt_key_example
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000

# Celery & Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Rate Limiting
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=5/minute
ORDER_RATE_LIMIT=20/minute
TASK_RATE_LIMIT=30/minute
DEFAULT_RATE_LIMIT=100/minute
AI_RATE_LIMIT=20/minute

# ==============================================================================
# DAY 20 - AI FOCUS CONFIGURATION (LLM Providers, Fallback & RAG)
# ==============================================================================

# Provider Selection:
# Primary provider: 'gemini', 'groq', 'mistral', or 'openai_compatible'
AI_PRIMARY_PROVIDER=gemini

# Ordered Fallback Chain (comma-separated):
AI_FALLBACK_PROVIDERS=groq,mistral,openai_compatible

# Groq API Configuration (Free tier: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini API Configuration (Free tier: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Mistral AI API Configuration (Free tier / Trial: https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# OpenAI / OpenAI-Compatible Configuration (vLLM, Ollama, Together, OpenAI)
OPENAI_API_KEY=sk_your_openai_or_custom_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Execution & Retry Strategy
AI_REQUEST_TIMEOUT=30.0
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_FACTOR=0.5
AI_MAX_MESSAGE_LENGTH=1000
AI_MAX_HISTORY_MESSAGES=6

# RAG & ChromaDB Configuration
CHROMA_PERSIST_DIR=chroma_db
# Embedding Provider: 'local_hash' (default zero-dep offline), 'gemini', 'mistral', or 'openai_compatible'
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=text-embedding-004
RAG_TOP_K=4
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
