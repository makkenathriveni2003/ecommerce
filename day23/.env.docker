# ============================================================================
# ShopZone Docker Environment Variables (.env.docker)
# Preconfigured for multi-container Docker Compose local development & testing
# ============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="ShopZone / GenZ Zone"
VERSION="2.0.0-devops"
DEBUG=false

# Networking & Ports
PORT=8000
FRONTEND_PORT=5173

# Database (PostgreSQL 16 Service in Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sqlight
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sqlight

# Redis Caching, Rate Limiting & Celery Broker
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_URL=redis://redis:6379/0

# Security & JWT Tokens
SECRET_KEY=supersecretjwtkey_docker_environment_change_in_production_min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Assistant & RAG Vector Database
CHROMA_PERSIST_DIRECTORY=/app/chroma_db
AI_EMBEDDING_PROVIDER=local_hash
AI_DEFAULT_LLM_PROVIDER=groq
AI_FALLBACK_PROVIDERS=groq,mistral,gemini
AI_CACHE_TTL_SECONDS=3600
AI_RATE_LIMIT="30/minute"
RAG_TOP_K=4
RAG_DISTANCE_THRESHOLD=1.65

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:80","http://localhost:8000","http://127.0.0.1:5173","http://127.0.0.1:8000"]
