# ShopZone Frontend Environment Configuration Template
# In Development:
VITE_API_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws

# In Production (e.g. AWS EC2 with domain & HTTPS or IP):
# VITE_API_URL=https://api.yourdomain.com
# VITE_WS_URL=wss://api.yourdomain.com/ws

# Optional Sentry Error Tracking (public client DSN):
VITE_SENTRY_DSN=
