# ==============================================================================
# ShopZone Day 25 Capstone - Production Environment Variables Template
# Copy to .env and populate with production credentials before deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Runtime Configuration
# ------------------------------------------------------------------------------
PROJECT_NAME="ShopZone E-Commerce API"
VERSION="1.0.0"
ENVIRONMENT="production"
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# 2. Production Server & Worker Concurrency (Gunicorn + Uvicorn)
# ------------------------------------------------------------------------------
# Recommended workers formula: (2 x CPU Cores) + 1. Example for 2 vCPU: 5 workers
WEB_CONCURRENCY=4
GUNICORN_WORKER_CLASS="uvicorn.workers.UvicornWorker"
GUNICORN_WORKER_CONNECTIONS=1000
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database & Connection Pooling (SQLAlchemy QueuePool)
# ------------------------------------------------------------------------------
DATABASE_ENGINE="postgres"
PGHOST="postgres"
PGPORT=5432
PGDATABASE="shopzone_production"
PGUSER="shopzone_admin"
PGPASSWORD="replace_with_strong_production_password_min_32_chars"

# Database Connection Pooling Tuning for 50-100 Concurrent Users
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# ------------------------------------------------------------------------------
# 4. Redis Caching & Celery Message Broker
# ------------------------------------------------------------------------------
REDIS_PASSWORD="replace_with_strong_redis_password"
CELERY_BROKER_URL="redis://:replace_with_strong_redis_password@redis:6379/0"
CELERY_RESULT_BACKEND="redis://:replace_with_strong_redis_password@redis:6379/1"
REDIS_URL="redis://:replace_with_strong_redis_password@redis:6379/0"

# ------------------------------------------------------------------------------
# 5. Security, JWT & CORS
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY="replace_with_64_character_cryptographically_secure_random_hex_string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins (HTTPS only in production)
FRONTEND_ORIGINS="https://shopzone.example.com,https://shopzone-preview.vercel.app"

# ------------------------------------------------------------------------------
# 6. Rate Limiting (SlowAPI)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT="5/minute"
REGISTER_RATE_LIMIT="5/minute"
ORDER_RATE_LIMIT="20/minute"
TASK_RATE_LIMIT="30/minute"
DEFAULT_RATE_LIMIT="100/minute"
AI_RATE_LIMIT="20/minute"

# ------------------------------------------------------------------------------
# 7. AI & ChromaDB Vector Store
# ------------------------------------------------------------------------------
AI_PRIMARY_PROVIDER="gemini"
AI_FALLBACK_PROVIDERS="groq,mistral,openai_compatible"
GEMINI_API_KEY="replace_with_google_gemini_api_key"
GEMINI_MODEL="gemini-1.5-flash"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
CHROMA_PERSIST_DIR="chroma_db"
EMBEDDING_PROVIDER="local_hash"
EMBEDDING_MODEL="text-embedding-004"
RAG_TOP_K=4

# ------------------------------------------------------------------------------
# 8. Observability, Sentry & Monitoring
# ------------------------------------------------------------------------------
SENTRY_DSN=""
PROMETHEUS_METRICS_ENABLED=true

# ------------------------------------------------------------------------------
# 9. Automated Database Backup & Disaster Recovery
# ------------------------------------------------------------------------------
BACKUP_DIR="/app/backups"
BACKUP_RETENTION_DAYS=7
